import example.pepita
import mensajeros.*
import paquetes.*
import vehiculos.*

describe "Tests: Primera parte." {

  test "Roberto puede llevar un paquete que está pago en un camión que tiene un acoplado." {
    paquete.pagado(true)
    camion.acoplados(1)
    roberto.vehiculo(camion)
    assert.that(roberto.puedeLlevarPaquete(paquete))
  }

  test "Neo con crédito no puede llevar un paquete que no está pago a la matrix." {
    assert.that(true)
  }
}